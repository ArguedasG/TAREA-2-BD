@model TAREA__2_BD_1.Models.Empleado

@{
    ViewData["Title"] = "Editar Empleado";
}

<h2>@ViewData["Title"]</h2>
@if (ViewData.ModelState[""]?.Errors.Count > 0)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState[""].Errors)
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}

<div class="card">
    <div class="card-body">
        <form asp-action="Editar" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <input asp-for="ValorDocumentoIdentidad" type="number" class="form-control" />
                <span asp-validation-for="ValorDocumentoIdentidad" class="text-danger"></span>
                <div class="invalid-feedback">
                    El documento de identidad debe ser numérico.
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Nombre"></label>
                <input asp-for="Nombre" type="text" class="form-control" pattern="[A-Za-zÁÉÍÓÚáéíóúÑñ\s]+" inputmode="text" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
                <div class="invalid-feedback">
                    El nombre debe contener solo letras y espacios.
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="IdPuesto">Puesto</label>
                <select asp-for="IdPuesto" class="form-control" asp-items="@(new SelectList(ViewBag.Puestos, "Id", "Nombre"))"></select>
                <span asp-validation-for="IdPuesto" class="text-danger"></span>
                <div class="invalid-feedback">
                    Debe seleccionar un puesto.
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>