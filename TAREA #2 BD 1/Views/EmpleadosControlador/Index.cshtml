@model List<TAREA__2_BD_1.Models.Empleado>

@{
    ViewData["Title"] = "Lista de Empleados";
    var filtro = ViewBag.Filtro as string ?? "";
}

<h2>@ViewData["Title"]</h2>

<div class="d-flex justify-content-between align-items-center mb-4">
    <form asp-action="Index" method="get" class="row g-3 align-items-center">
        <div class="col-auto">
            <input type="text" name="filtro" value="@filtro" class="form-control" placeholder="Buscar por nombre o cédula" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-dark">Buscar</button>
        </div>
    </form>
    <a asp-action="Crear" class="btn btn-success">Insertar Nuevo Empleado</a>
    <a asp-action="Actualizar" class="btn btn-primary">Actualizar Empleado</a>
    <a asp-action="Eliminar" class="btn btn-danger">Eliminar Empleado</a>
    <a asp-action="Consultar" class="btn btn-info">Consultar Empleado</a>
    <a asp-action="Movimientos" class="btn btn-warning">Movimientos</a>

</div>

@if (Model != null && Model.Count > 0)
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Documento identidad</th>
                <th>Nombre</th>
                <th>ID Puesto</th>
                <th>Contratacion</th>
                <th>Saldo Vacaciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var empleado in Model)
            {
                <tr>
                    <td>@empleado.ValorDocumentoIdentidad</td>
                    <td>@empleado.Nombre</td>
                    <td>@empleado.IdPuesto</td>
                    <td>@empleado.FechaContratacion</td>
                    <td>@empleado.SaldoVacaciones</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No se encontraron empleados que coincidan con el filtro.</div>
}
