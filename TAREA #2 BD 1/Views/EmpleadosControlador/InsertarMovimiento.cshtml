@model TAREA__2_BD_1.Models.Movimiento

<div class="container">
    <h2>Insertar Movimiento</h2>

    <form asp-action="InsertarMovimiento" method="post">
        <input type="hidden" asp-for="FechaMovimiento" />
        <input type="hidden" asp-for="NuevoSaldo" />
        <input type="hidden" asp-for="NombreUsuario" />
        <input type="hidden" asp-for="IP" />
        <input type="hidden" asp-for="FechaHoraRegistro" />
        <input type="hidden" name="valorDocumentoIdentidad" value="@ViewBag.ValorDocumentoIdentidad" />

        <!-- Campo para seleccionar el tipo de movimiento -->
        <div class="form-group">
            <label for="Id">Tipo de Movimiento</label>
            <select asp-for="IdTipoMovimiento" class="form-control" required>
                <option value="">Seleccione un tipo de movimiento</option>
                @foreach (var tipo in ViewBag.TiposMovimiento as List<TAREA__2_BD_1.Models.TipoMovimiento>)
                {
                    <option value="@tipo.Id">@tipo.Nombre (@tipo.TipoAccion)</option>
                }
            </select>
            <span asp-validation-for="IdTipoMovimiento" class="text-danger"></span>
        </div>

        <!-- Campo para ingresar el monto -->
        <div class="form-group">
            <label for="Monto">Monto</label>
            <input asp-for="Monto" class="form-control" type="number" step="0.01" placeholder="Ingrese el monto" required />
            <span asp-validation-for="Monto" class="text-danger"></span>
        </div>

        <!-- Botones de acción -->
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Guardar Movimiento</button>
            <a asp-action="Movimientos" asp-route-valorDocumentoIdentidad="@ViewBag.ValorDocumentoIdentidad" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}